# Production runtime: Supabase data store
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key

# Production runtime: admin auth and Vercel Blob storage
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash
ADMIN_SESSION_SECRET=your_high_entropy_session_secret_at_least_32_characters
# Existing public store for product images.
BLOB_STORE_ID=store_xxxxxxxxxxxxxxxxxxxx
# Separate private store for payment slips. Both stores use Vercel OIDC.
PAYMENT_SLIP_BLOB_STORE_ID=store_xxxxxxxxxxxxxxxxxxxx

# Optional during the historical-slip transition only.
# Keep these while any orders.slip_file_id values are unprefixed Drive IDs.
GOOGLE_DRIVE_CLIENT_ID=your_drive_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_drive_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_drive_oauth_refresh_token

# Optional one-time migration/recovery tooling only.
# These are used by npm run supabase:import:* and npm run supabase:verify.
GOOGLE_ORDER_SPREADSHEET_ID=your_google_sheet_id
GOOGLE_ORDERS_RANGE=Orders!A:Q
GOOGLE_ORDER_ITEMS_RANGE=OrderItems!A:H
GOOGLE_PRODUCTS_RANGE='Products'!A:H
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account-name@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
